<Window
    x:Class="TelemetryDesktopApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="IoT Telemetry Dashboard">

    <Grid Background="#F5F7FC">
        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Padding="28"
                Spacing="22"
                MaxWidth="1100"
                HorizontalAlignment="Stretch">

                <!-- HEADER -->
                <StackPanel Spacing="6">
                    <TextBlock
                        Text="IoT Telemetry Dashboard"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="#24324B"/>

                    <TextBlock
                        Text="ESP32 • Raspberry Pi • MQTT • Azure IoT"
                        FontSize="14"
                        Foreground="#75839A"/>
                </StackPanel>

                <!-- OVERVIEW -->
                <TextBlock
                    Text="Översikt"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#24324B"/>

                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- API STATUS -->
                    <Border
                        Grid.Column="0"
                        Background="#E7F4EF"
                        CornerRadius="16"
                        Padding="20">

                        <StackPanel Spacing="12">
                            <TextBlock
                                Text="API-anslutning"
                                FontSize="14"
                                Foreground="#527565"/>

                            <TextBlock
                                x:Name="ConnectionStatusText"
                                Text="Ansluter..."
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="#225D47"
                                TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- AVERAGE TEMPERATURE -->
                    <Border
                        Grid.Column="1"
                        Background="#E9F0FF"
                        CornerRadius="16"
                        Padding="20">

                        <StackPanel Spacing="10">
                            <TextBlock
                                Text="Genomsnittlig temperatur"
                                FontSize="14"
                                Foreground="#60749C"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                Text="Average · alla sensorer"
                                FontSize="12"
                                Foreground="#75839A"/>

                            <TextBlock
                                x:Name="TemperatureValueText"
                                Text="-- °C"
                                FontSize="27"
                                FontWeight="Bold"
                                Foreground="#304E87"/>
                        </StackPanel>
                    </Border>

                    <!-- AVERAGE HUMIDITY -->
                    <Border
                        Grid.Column="2"
                        Background="#F0EAFE"
                        CornerRadius="16"
                        Padding="20">

                        <StackPanel Spacing="10">
                            <TextBlock
                                Text="Genomsnittlig luftfuktighet"
                                FontSize="14"
                                Foreground="#8069A3"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                Text="Average · alla sensorer"
                                FontSize="12"
                                Foreground="#75839A"/>

                            <TextBlock
                                x:Name="HumidityValueText"
                                Text="-- %"
                                FontSize="27"
                                FontWeight="Bold"
                                Foreground="#67458D"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- DEVICES -->
                <TextBlock
                    Text="ESP32-enheter"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#24324B"/>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ESP32 #1 -->
                    <Border
                        Grid.Column="0"
                        Background="White"
                        CornerRadius="18"
                        Padding="22">

                        <StackPanel Spacing="14">
                            <TextBlock
                                Text="ESP32 #1"
                                FontSize="19"
                                FontWeight="Bold"
                                Foreground="#24324B"/>

                            <TextBlock
                                Text="qurat-esp32-01"
                                FontSize="13"
                                Foreground="#75839A"/>

                            <TextBlock
                                x:Name="NanoStatusText"
                                Text="Väntar på data"
                                Foreground="#16A34A"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Temperatur · qurat-esp32-01"
                                Foreground="#75839A"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                x:Name="NanoTemperatureText"
                                Text="-- °C"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Foreground="#304E87"/>

                            <TextBlock
                                Text="Luftfuktighet · qurat-esp32-01"
                                Foreground="#75839A"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                x:Name="NanoHumidityText"
                                Text="-- %"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Foreground="#67458D"/>

                            <TextBlock
                                x:Name="NanoUpdatedText"
                                Text="Updated --"
                                FontSize="12"
                                Foreground="#75839A"/>
                        </StackPanel>
                    </Border>

                    <!-- ESP32 #2 -->
                    <Border
                        Grid.Column="1"
                        Background="White"
                        CornerRadius="18"
                        Padding="22">

                        <StackPanel Spacing="14">
                            <TextBlock
                                Text="ESP32 #2"
                                FontSize="19"
                                FontWeight="Bold"
                                Foreground="#24324B"/>

                            <TextBlock
                                Text="qurat-esp32-s3-02"
                                FontSize="13"
                                Foreground="#75839A"/>

                            <TextBlock
                                x:Name="S3StatusText"
                                Text="Väntar på data"
                                Foreground="#16A34A"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Temperatur · qurat-esp32-s3-02"
                                Foreground="#75839A"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                x:Name="S3TemperatureText"
                                Text="-- °C"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Foreground="#304E87"/>

                            <TextBlock
                                Text="Luftfuktighet · qurat-esp32-s3-02"
                                Foreground="#75839A"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                x:Name="S3HumidityText"
                                Text="-- %"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Foreground="#67458D"/>

                            <TextBlock
                                x:Name="S3UpdatedText"
                                Text="Updated --"
                                FontSize="12"
                                Foreground="#75839A"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- SENSOR LIST -->
                <TextBlock
                    Text="Sensorlista"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#24324B"/>

                <Border
                    Background="White"
                    CornerRadius="18"
                    Padding="20">

                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Aktuella mätvärden från API"
                            FontSize="14"
                            Foreground="#75839A"/>

                        <ListView
                            x:Name="SensorList"
                            Height="230"
                            SelectionMode="None">

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="#F5F7FC"
                                        CornerRadius="10"
                                        Padding="12"
                                        Margin="0,4">

                                        <TextBlock
                                            Text="{Binding}"
                                            FontSize="14"
                                            Foreground="#30405B"
                                            TextWrapping="Wrap"/>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- CONNECTIONS -->
                <TextBlock
                    Text="Anslutningar"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="#24324B"/>

                <Border
                    Background="White"
                    CornerRadius="18"
                    Padding="20">

                    <StackPanel Spacing="12">
                        <TextBlock
                            Text="Raspberry Pi API"
                            FontWeight="SemiBold"
                            Foreground="#24324B"/>

                        <TextBlock
                            Text="http://127.0.0.1:8000/api/devices"
                            TextWrapping="Wrap"
                            Foreground="#75839A"/>

                        <TextBlock
                            Text="MQTT och Azure IoT Hub hanteras av gatewayen. Dashboarden hämtar data via HTTP API."
                            TextWrapping="Wrap"
                            Foreground="#75839A"/>
                    </StackPanel>
                </Border>

                <TextBlock
                    Text="TelemetryDesktopApp • Uppdateras var 5:e sekund"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="#8994A8"
                    Margin="0,8,0,20"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
